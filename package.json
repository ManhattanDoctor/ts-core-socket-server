{
    "name": "@ts-core/socket-server",
    "version": "3.0.28",
    "description": "TypeScript WebSocket server library based on Socket.IO with RxJS support, rooms management, user sessions, and command handlers",
    "main": "./cjs/public-api.js",
    "module": "./esm/public-api.js",
    "exports": {
        ".": {
            "import": "./esm/public-api.js",
            "require": "./cjs/public-api.js"
        }
    },
    "scripts": {},
    "author": {
        "name": "Renat Gubaev",
        "email": "renat.gubaev@gmail.com"
    },
    "license": "ISC",
    "dependencies": {
        "@ts-core/socket-common": "~3.0.14",
        "socket.io": "^4.8.1"
    },
    "devDependencies": {
        "@types/node": "^14.14.31",
        "gulp-npm-module-publisher": "^3.0.5"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ManhattanDoctor/ts-core-socket-server.git"
    },
    "keywords": [
        "typescript",
        "websocket",
        "socket.io",
        "socket-server",
        "rxjs",
        "real-time",
        "rooms",
        "nestjs",
        "ts-core"
    ],
    "bugs": {
        "url": "https://github.com/ManhattanDoctor/ts-core-socket-server/issues"
    },
    "homepage": "https://github.com/ManhattanDoctor/ts-core-socket-server#readme"
